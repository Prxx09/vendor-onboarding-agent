SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_RETRIES=3

# OCR / document extraction
OCR_PROVIDER=windows
# Optional BCP-47 tag such as en-US. Empty = Windows user-profile OCR language.
OCR_LANGUAGE=en-US
OCR_MAX_PDF_PAGES=20
OCR_PDF_RENDER_SCALE=2.0
PDF_NATIVE_TEXT_MIN_CHARS=40
DOCUMENT_TEXT_MAX_CHARS=30000

# Frontend/backend policy. The frontend reads these through GET /api/v1/config.
MAX_UPLOAD_FILES=8
MAX_FILE_SIZE_MB=20
MAX_COMBINED_UPLOAD_MB=100
# Optional. Accepts either 0-1 (for example 0.90) or 0-100 (for example 90).
AUTO_APPROVAL_THRESHOLD=
REQUIRED_INTAKE_FIELDS=legal_name,tax_id,bank_account,ifsc,registered_address,compliance_confirmed
# Optional comma-separated suggestions. Leave empty to allow free text only.
VENDOR_REGIONS=
VENDOR_CATEGORIES=
DOCUMENT_STORAGE_BUCKET=verification-documents

VERIFICATION_PROVIDER_MODE=supabase

COMPANY_REGISTRY_API_URL=
TAX_REGISTRY_API_URL=
BANK_VERIFICATION_API_URL=
KYC_API_URL=
SANCTIONS_API_URL=
OFFICIAL_API_KEY=
OFFICIAL_API_KEY_HEADER=Authorization
